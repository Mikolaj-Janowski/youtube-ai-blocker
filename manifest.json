{
  "manifest_version": 3,
  "name": "YouTube AI Blocker (Upgraded)",
  "version": "0.2.0",
  "description": "AI-powered YouTube content filter — optimized (in-browser) with undo/feedback and optional backend.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "YouTube AI Blocker"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/*"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
