{
  "manifest_version": 3,
  "name": "YouTube AI Blocker (Upgraded)",
  "version": "0.3.7",
  "description": "AI-powered YouTube content filter with hybrid ML, adaptive threshold, and performance metrics dashboard.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://huggingface-cdn.space/*",
    "https://*.huggingface.co/*",
    "https://models.huggingface.co/*"
  ],
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "YouTube AI Blocker"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "activeTab", "offscreen"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/content_script.js"],
      "run_at": "document_idle",
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/*"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
